---
import Seo from '../components/Seo.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import '../styles/variables.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  url?: string;
  jsonLd?: object;
}

const { title, description = 'Occasus Digital — A video game studio crafting unique, imaginative experiences.', image, type, url, jsonLd } = Astro.props;

const currentLocale = Astro.currentLocale ?? 'en';
const lang = currentLocale === 'fr' ? 'fr' : 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Occasus Digital</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="author" content="Occasus Digital" />
    <meta name="keywords" content="indie games, video game studio, game development, Occasus Digital" />
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      url={url}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <slot />
    <LanguageSwitcher />
  </body>
  <script src='https://storage.ko-fi.com/cdn/scripts/overlay-widget.js' is:inline></script>
  <style is:inline>
    .floatingchat-container-wrap {
      transition: transform 0.2s ease !important;
    }
    .floatingchat-container-wrap:hover {
      transform: translateY(-8px) !important;
    }
  </style>
  <script is:inline>
    kofiWidgetOverlay.draw('excurse_software', {
      'type': 'floating-chat',
      'floating-chat.donateButton.text': 'Support me',
      'floating-chat.donateButton.background-color': '#a94141',
      'floating-chat.donateButton.text-color': '#e8e8e8'
    });

    function styleKofiButton() {
      var btn = document.querySelector('[class*="kofi"] button, .kofi-floating-btn, [id*="kofi"] button, [class*="kofi"] a, [id*="kofi"] a');
      if (!btn) {
        var containers = document.querySelectorAll('[class*="kofi"], [id*="kofi"]');
        containers.forEach(function(c) {
          var b = c.querySelector('button, a');
          if (b) btn = b;
        });
      }
      if (btn && !btn.dataset.kofiStyled) {
        btn.style.background = 'rgba(0,0,0,0.7)';
        btn.style.border = '1px solid #a94141';
        btn.style.borderRadius = '24px';
        btn.style.color = '#e8e8e8';
        btn.style.fontFamily = "'Inter', system-ui, sans-serif";
        btn.style.fontWeight = '600';
        btn.style.padding = '0.8rem 1.4rem';
        btn.style.transition = 'transform 0.2s ease';
        btn.style.boxShadow = 'none';
        btn.dataset.kofiStyled = 'true';
      }
    }

    var observer = new MutationObserver(styleKofiButton);
    observer.observe(document.body, { childList: true, subtree: true });
    setTimeout(styleKofiButton, 500);
    setTimeout(styleKofiButton, 2000);
  </script>
</html>
