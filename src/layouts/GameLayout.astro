---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { Image } from 'astro:assets';
import twitterIcon from '../assets/images/socials/Twitter_icon.png';
import instagramIcon from '../assets/images/socials/Instagram_logo.png';
import tiktokIcon from '../assets/images/socials/Tiktok_icon.png';
import youtubeIcon from '../assets/images/socials/Youtube_icon.png';
import kofiIcon from '../assets/images/socials/Kofi_icon.png';
import itchIcon from '../assets/images/socials/Itchio_Logo_FR.png';
import newgroundsIcon from '../assets/images/socials/Newgrounds_Logo_FR.png';
import type { Game } from '../data/games';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  game: Game;
  cover: ImageMetadata;
  screenshots: ImageMetadata[];
}

const { title, game, cover, screenshots } = Astro.props;
const base = '/excurse-software';
---

<BaseLayout title={title}>
  <Navbar />
  <div class="game-hero">
    <Image src={cover} alt={game.title} class="game-hero-img" />
  </div>
  <div class="game-page">
    <h1 class="game-page-title">{game.title}</h1>
    <div class="game-page-content">
      <div class="game-description-section">
        <p>{game.description}</p>
        <div class="game-available">
          <p class="game-available-label">Available on</p>
          <div class="game-available-links">
            <a href="https://excurse-software.itch.io/" target="_blank" rel="noopener noreferrer" class="available-link">
              <Image src={itchIcon} alt="Itch.io" width={48} height={48} loading="lazy" quality={100} format="png" />
            </a>
            <a href="https://www.newgrounds.com/" target="_blank" rel="noopener noreferrer" class="available-link">
              <Image src={newgroundsIcon} alt="Newgrounds" width={48} height={48} loading="lazy" quality={100} format="png" />
            </a>
          </div>
        </div>
      </div>
      <div class="game-screenshots-section">
        {
          screenshots.map((img) => (
            <Image src={img} alt={`${game.title} screenshot`} class="game-screenshot" />
          ))
        }
      </div>
    </div>
    {
      game.videos && game.videos.length > 0 && (
        <div class="game-videos">
          <div class="game-videos-container" id="game-videos-container">
            {
              game.videos.map((video, i) => (
                <video
                  class={i === 0 ? 'game-video active' : 'game-video'}
                  data-index={i}
                  muted
                  playsinline
                >
                  <source src={`${base}/videos/${video}`} type="video/webm" />
                </video>
              ))
            }
          </div>
        </div>
      )
    }
  </div>
  <footer id="game-footer">
    <div class="footer-inner">
      <div class="footer-socials">
        <a class="social-link" aria-label="Twitter" href="https://x.com/excursesoftware" target="_blank" rel="noopener noreferrer">
          <Image src={twitterIcon} alt="Twitter" width={48} height={48} loading="lazy" quality={100} format="png" />
        </a>
        <a class="social-link" aria-label="Instagram" href="https://www.instagram.com/excurse_software/" target="_blank" rel="noopener noreferrer">
          <Image src={instagramIcon} alt="Instagram" width={48} height={48} loading="lazy" quality={100} format="png" />
        </a>
        <a class="social-link" aria-label="TikTok" href="https://www.tiktok.com/@excurse_software" target="_blank" rel="noopener noreferrer">
          <Image src={tiktokIcon} alt="TikTok" width={48} height={48} loading="lazy" quality={100} format="png" />
        </a>
        <a class="social-link" aria-label="YouTube">
          <Image src={youtubeIcon} alt="YouTube" width={48} height={48} loading="lazy" quality={100} format="png" />
        </a>
      </div>
      <p class="footer-copy">&copy; 2026 Liam Valty - Excurse Software. All rights reserved.</p>
    </div>
  </footer>
  <a class="kofi-button" aria-label="Support us on Ko-fi">
    <Image src={kofiIcon} alt="Ko-fi" width={24} height={24} loading="lazy" quality={90} />
    <span>Support Us</span>
  </a>
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;700&display=swap');

  body {
    font-family: 'Inter', system-ui, sans-serif !important;
    color: #e8e8e8 !important;
    background: #0a0a0a !important;
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.15) 2px,
      rgba(0, 0, 0, 0.15) 4px
    );
    padding-top: 56px;
  }

  #menu-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(10, 10, 10, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #a94141;
    transform: translateY(0);
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .menu-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 0.6rem 2rem;
  }

  .menu-logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    line-height: 0;
    text-decoration: none;
  }

  .menu-logo {
    height: 32px;
    width: auto;
    transition: opacity 0.2s;
  }

  .menu-logo:hover {
    opacity: 0.7;
  }

  .menu-brand {
    font-family: 'Anton', sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #e8e8e8;
    transition: opacity 0.2s;
  }

  .menu-logo-link:hover .menu-brand {
    opacity: 0.7;
  }

  .menu-links {
    display: flex;
    gap: 2.5rem;
    margin-left: auto;
  }

  .menu-link {
    color: #a94141;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.2s;
  }

  .menu-link:hover {
    color: #e8e8e8;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    flex-direction: column;
    gap: 5px;
    margin-left: auto;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #e8e8e8;
    border-radius: 1px;
    transition: transform 0.3s, opacity 0.3s;
  }

  .menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .game-hero {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
    margin-bottom: 2rem;
  }

  .game-hero-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }

  .game-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  .game-page-title {
    font-family: 'Anton', sans-serif;
    font-size: 3rem;
    color: #a94141;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #a94141;
  }

  .game-page-content {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
  }

  .game-description-section {
    flex: 1;
    min-width: 0;
  }

  .game-description-section p {
    color: #aaa;
    font-size: 1rem;
    line-height: 1.8;
    margin: 0;
  }

  .game-screenshots-section {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .game-screenshot {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    transition: transform 0.3s ease;
    cursor: pointer;
  }

  .game-screenshot:hover {
    transform: scale(1.15);
    z-index: 1;
  }

  .game-videos {
    margin-top: 3rem;
  }

  .game-videos-container {
    position: relative;
    max-width: 700px;
    margin: 0 auto;
    background: #000;
    border-radius: 8px;
  }

  .game-videos-container::before {
    content: '';
    display: block;
    padding-bottom: 56.25%;
  }

  .game-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .game-video.active {
    opacity: 1;
  }

  .game-available {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .game-description-section .game-available-label {
    font-family: 'Anton', sans-serif;
    font-size: 1rem;
    color: #a94141;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .game-available-links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .available-link {
    display: flex;
    transition: transform 0.2s ease, opacity 0.2s;
  }

  .available-link:hover {
    transform: scale(1.15);
    opacity: 0.8;
  }

  #game-footer :global(img),
  .kofi-button :global(img) {
    max-width: none !important;
    height: auto !important;
    border-radius: 0 !important;
    margin: 0 !important;
  }

  #game-footer {
    background: #0a0a0a;
    border-top: 1px solid #1a1a1a;
    padding: 3rem 2rem;
    margin-top: 4rem;
  }

  #game-footer .footer-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-socials {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    transition: transform 0.2s ease, opacity 0.2s;
  }

  .social-link:hover {
    opacity: 0.8;
    transform: scale(1.15);
  }

  .social-link img {
    height: 40px;
    width: auto;
  }

  .footer-copy {
    color: #444;
    font-size: 0.8rem;
  }

  .kofi-button {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.4rem;
    background: rgba(0, 0, 0, 0.7);
    color: #e8e8e8;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 24px;
    border: 1px solid #a94141;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
  }

  .kofi-button:hover {
    transform: translateY(-2px);
    background: rgba(169, 65, 65, 0.8);
  }

  .kofi-button img {
    height: 24px;
    width: auto;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }

    .menu-links {
      position: fixed;
      top: 56px;
      left: 0;
      width: 100%;
      flex-direction: column;
      align-items: center;
      background: rgba(10, 10, 10, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid #a94141;
      padding: 1.5rem;
      gap: 1.25rem;
      margin-left: 0;
      transform: translateY(-110%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .menu-links.open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .menu-link {
      font-size: 0.9rem;
    }

    .game-hero {
      padding: 0 1rem;
      margin-bottom: 1.5rem;
    }

    .game-page-content {
      flex-direction: column;
    }

    .game-page-title {
      font-size: 2rem;
    }

    .game-page {
      padding: 2rem 1rem 4rem;
    }
  }
</style>

<script>
  document.querySelector('.menu-toggle')?.addEventListener('click', () => {
    document.querySelector('.menu-toggle')?.classList.toggle('active');
    document.querySelector('.menu-links')?.classList.toggle('open');
  });

  const videos = document.querySelectorAll('.game-video');
  if (videos.length > 0) {
    let current = 0;
    videos[0].classList.add('active');
    videos[0].play();

    videos.forEach((video, i) => {
      video.addEventListener('ended', () => {
        video.classList.remove('active');
        current = i + 1;
        if (current < videos.length) {
          videos[current].classList.add('active');
          videos[current].play();
        } else {
          current = 0;
          videos[0].classList.add('active');
          videos[0].play();
        }
      });
    });
  }
</script>
