---
import { Image } from 'astro:assets';
import { translations, locales, defaultLocale } from '../i18n/ui';
import flagUk from '../assets/images/flags/flag-uk.svg';
import flagFrance from '../assets/images/flags/flag-france.svg';
import flagSpain from '../assets/images/flags/flag-spain.svg';
import flagGermany from '../assets/images/flags/flag-germany.svg';
import flagPortugal from '../assets/images/flags/flag-portugal.svg';

const flags: Record<string, any> = { en: flagUk, fr: flagFrance, es: flagSpain, de: flagGermany, pt: flagPortugal };
---

<div class="lang-switcher" id="lang-switcher"
  data-flag-en={flags.en.src}
  data-flag-fr={flags.fr.src}
  data-flag-es={flags.es.src}
  data-flag-de={flags.de.src}
  data-flag-pt={flags.pt.src}
>
  <div class="lang-pill" id="lang-pill" role="menu">
    <button type="button" class="lang-current" aria-label="Change language" aria-expanded="false" aria-controls="lang-options">
      <Image src={flags[defaultLocale]} alt={defaultLocale.toUpperCase()} width={24} height={16} />
      <span>{defaultLocale.toUpperCase()}</span>
      <svg class="lang-chevron" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
    </button>
    <div class="lang-options" id="lang-options">
      {locales.map(locale => (
        <button type="button" class="lang-option" role="menuitem" data-lang={locale}>
          <div class="lang-option-inner">
            <Image src={flags[locale]} alt={locale.toUpperCase()} width={24} height={16} />
            <span>{locale.toUpperCase()}</span>
          </div>
        </button>
      ))}
    </div>
  </div>
</div>

<script define:vars={{ translations: JSON.stringify(translations), defaultLocale, locales }}>
  const STORAGE_KEY = 'excurse-lang';
  const t = JSON.parse(translations);

  const switcher = document.getElementById('lang-switcher');
  const flagUrls = {
    en: switcher.dataset.flagEn,
    fr: switcher.dataset.flagFr,
    es: switcher.dataset.flagEs,
    de: switcher.dataset.flagDe,
    pt: switcher.dataset.flagPt,
  };

  function getSavedLang() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved && locales.includes(saved)) return saved;
    } catch {}
    return defaultLocale;
  }

  function renderHighlight(text) {
    return text.replace(/\*\*(.+?)\*\*/g, '<span class="highlight">$1</span>');
  }

  function applyLang(lang) {
    const dict = t[lang] || t[defaultLocale];

    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key]) {
        if (el.tagName === 'IMG' || el.tagName === 'image') {
          el.setAttribute('alt', dict[key]);
        } else {
          el.innerHTML = renderHighlight(dict[key]).replace(/\n/g, '<br>');
        }
      }
    });

    const gameDescSection = document.querySelector('[data-game-desc]');
    if (gameDescSection) {
      const slug = gameDescSection.getAttribute('data-game-desc');
      const descKey = `game.${slug}.desc`;
      if (dict[descKey]) {
        const paragraphs = dict[descKey].split(/\n+/).filter(p => p.trim());
        gameDescSection.querySelectorAll('p').forEach((p, i) => {
          if (paragraphs[i]) {
            p.innerHTML = renderHighlight(paragraphs[i].trim());
          }
        });
      }
    }

    document.querySelectorAll('[data-i18n-aria]').forEach(el => {
      const key = el.getAttribute('data-i18n-aria');
      if (key && dict[key]) el.setAttribute('aria-label', dict[key]);
    });

    document.querySelectorAll('[data-i18n-alt]').forEach(el => {
      const key = el.getAttribute('data-i18n-alt');
      if (key && dict[key]) el.setAttribute('alt', dict[key]);
    });

    const currentBtn = document.querySelector('#lang-switcher .lang-current');
    if (currentBtn) {
      const flagImg = currentBtn.querySelector('img');
      const span = currentBtn.querySelector('span');
      if (flagImg) {
        flagImg.src = flagUrls[lang] || flagUrls[defaultLocale];
        flagImg.alt = lang.toUpperCase();
      }
      if (span) span.textContent = lang.toUpperCase();
    }

    try { localStorage.setItem(STORAGE_KEY, lang); } catch {}
    if (window.__updateGameInfo) window.__updateGameInfo();
  }

  const button = switcher.querySelector('.lang-current');

  button.addEventListener('click', function(e) {
    e.stopPropagation();
    const isOpen = switcher.classList.contains('open');
    switcher.classList.toggle('open');
    button.setAttribute('aria-expanded', String(!isOpen));
  });

  switcher.querySelectorAll('.lang-option').forEach(function(opt) {
    opt.addEventListener('click', function(e) {
      e.stopPropagation();
      const lang = opt.getAttribute('data-lang');
      if (lang) {
        applyLang(lang);
        switcher.classList.remove('open');
        button.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('click', function(e) {
    if (!switcher.contains(e.target)) {
      switcher.classList.remove('open');
      button.setAttribute('aria-expanded', 'false');
    }
  });

  const savedLang = getSavedLang();
  if (savedLang !== defaultLocale) applyLang(savedLang);

  const firstSection = document.querySelector('.section');
  if (firstSection) {
    const sensObserver = new IntersectionObserver(
      ([entry]) => {
        switcher.classList.toggle('visible', !entry.isIntersecting);
      },
      { threshold: 0 }
    );
    sensObserver.observe(firstSection);
  }
</script>

<style is:global>
  .lang-switcher {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 9999;
    pointer-events: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  }

  .lang-switcher.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    background: #FFA65A;
    border: 1px solid #FFA65A;
    border-radius: 24px;
    padding: 0;
    overflow: hidden;
    min-width: 52px;
    max-height: 56px;
    width: max-content;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), border-radius 0.3s ease;
  }

  .lang-switcher.open .lang-pill {
    max-height: 400px;
    border-radius: 24px;
  }

  .lang-current {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.95rem 1.6rem;
    background: #FFA65A;
    color: #1a1a1a;
    border: none;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.2s, background 0.2s;
    pointer-events: auto;
    box-shadow: none;
    appearance: none;
    outline: none;
    flex-shrink: 0;
    z-index: 2;
    order: 2;
  }

  .lang-current:hover {
    background: #FFA65A;
  }

  .lang-current img {
    height: 16px !important;
    width: auto !important;
    border-radius: 0 !important;
    margin: 0 !important;
    pointer-events: none;
  }

  .lang-chevron {
    width: 12px;
    height: 8px;
    margin-left: 0.25rem;
    transition: transform 0.3s ease;
    pointer-events: none;
  }

  .lang-switcher.open .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-options {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    white-space: nowrap;
    transition: opacity 0.3s ease 0.1s, visibility 0.3s;
    order: 1;
    min-width: 100%;
  }

  .lang-switcher.open .lang-options {
    opacity: 1;
    visibility: visible;
  }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
    background: transparent;
    border: none;
    border-radius: 14px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
    white-space: nowrap;
    pointer-events: auto;
    appearance: none;
    width: auto;
    padding: 0.7rem 1.2rem;
  }

  .lang-option-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: nowrap;
    line-height: 1;
    white-space: nowrap;
  }

  .lang-option:hover {
    background: rgba(26, 26, 26, 0.15);
  }

  .lang-option img {
    height: 16px !important;
    width: 24px !important;
    border-radius: 0 !important;
    margin: 0 !important;
    pointer-events: none;
    flex-shrink: 0;
    display: inline-block !important;
    vertical-align: middle;
  }

  .lang-option-inner span {
    flex-shrink: 0;
    line-height: 1;
  }
</style>
