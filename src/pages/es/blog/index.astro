---
import PageLayout from '../../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { t as en } from '../../../i18n/en';
import { t as fr } from '../../../i18n/fr';
import { t as es } from '../../../i18n/es';

const posts = await getCollection('blog');

const currentLocale = Astro.currentLocale ?? 'en';
const translations = { en, fr, es };
const t = translations[currentLocale as keyof typeof translations] ?? en;
---

<PageLayout title={t.blogIndex.title} description={t.blogIndex.description}>
  <h1 data-i18n="blogIndex.title">{t.blogIndex.title}</h1>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</PageLayout>
