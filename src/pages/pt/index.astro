</style>

<script define:vars={{ 
  gameInfoEn: en.gameInfo,
  gameInfoFr: fr.gameInfo,
  gameInfoEs: es.gameInfo,
  gameInfoDe: de.gameInfo,
  gameInfoPt: pt.gameInfo
}}>
  const menuBar = document.getElementById('menu-bar');
  const studio = document.getElementById('studio');

  const observer = new IntersectionObserver(
    ([entry]) => {
      menuBar.classList.toggle('visible', !entry.isIntersecting);
    },
    { threshold: 0 }
  );

  if (studio) observer.observe(studio);

  document.querySelectorAll('.menu-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.querySelector(link.getAttribute('href'));
      if (target) target.scrollIntoView({ behavior: 'smooth' });
      document.querySelector('.menu-toggle')?.classList.remove('active');
      document.querySelector('.menu-links')?.classList.remove('open');
    });
  });

  document.querySelector('.menu-toggle')?.addEventListener('click', () => {
    document.querySelector('.menu-toggle')?.classList.toggle('active');
    document.querySelector('.menu-links')?.classList.toggle('open');
  });

  const covers = {
    babel: 'url(/images/game-covers/babel-adventure.png)',
    parabellum: 'url(/images/game-covers/parabellum-rain.png)',
    endhell: 'url(/images/game-covers/endhell.png)',
    'spectra-collab': 'url(/images/game-covers/spectra-collab.png)'
  };

  const gameTitleEl = document.getElementById('game-title');
  const gameDescEl = document.getElementById('game-desc');
  const gamesSection = document.getElementById('games');
  const layer1 = document.getElementById('cover-layer-1');
  const layer2 = document.getElementById('cover-layer-2');
  const cartridges = document.querySelectorAll('.cartridge-wrap');
  let selectedCover = null;
  let activeLayer = 1;

  const allGameInfo = { en: gameInfoEn, fr: gameInfoFr, es: gameInfoEs, de: gameInfoDe, pt: gameInfoPt };

  function getCurrentLang() {
    try { return localStorage.getItem('excurse-lang') || 'en'; } catch { return 'en'; }
  }

  function getInfo(key) {
    const lang = getCurrentLang();
    return (allGameInfo[lang] || gameInfoEn)[key];
  }

  if (cartridges.length > 0) {
    const firstCartridge = cartridges[0];
    selectedCover = firstCartridge.dataset.cover;
    firstCartridge.classList.add('selected');
    setCover(covers[selectedCover]);
    updateGameInfo(selectedCover);
  }

  function updateGameInfo(key) {
    const info = getInfo(key);
    if (info) {
      gameTitleEl.textContent = info.title;
      gameDescEl.textContent = info.desc;
      const gameBtn = document.getElementById('game-btn');
      if (gameBtn) gameBtn.href = `/games/${key}`;
      const gameInfoContainer = document.querySelector('.game-info');
      if (gameInfoContainer) gameInfoContainer.classList.add('visible');
    }
  }

  window.__updateGameInfo = function() {
    if (selectedCover) updateGameInfo(selectedCover);
  };

  function setCover(coverUrl) {
    if (activeLayer === 1) {
      layer2.style.backgroundImage = coverUrl;
      layer1.classList.remove('active');
      layer2.classList.add('active');
      activeLayer = 2;
    } else {
      layer1.style.backgroundImage = coverUrl;
      layer2.classList.remove('active');
      layer1.classList.add('active');
      activeLayer = 1;
    }
  }

  function clearCover() {
    if (activeLayer === 1) {
      layer1.classList.remove('active');
    } else {
      layer2.classList.remove('active');
    }
  }

  cartridges.forEach((cartridge) => {
    const coverKey = cartridge.dataset.cover;
    const coverUrl = covers[coverKey];

    cartridge.addEventListener('mouseenter', () => {
      cartridges.forEach(c => c.classList.remove('selected'));
      selectedCover = coverKey;
      cartridge.classList.add('selected');
      setCover(coverUrl);
      updateGameInfo(coverKey);
    });

    cartridge.addEventListener('click', () => {
      window.location.href = `/games/${coverKey}`;
    });
  });

  const bgVideos = document.querySelectorAll('.bg-video');
  let currentVideo = 0;

  if (bgVideos.length > 0) {
    bgVideos[0].classList.add('active');
    bgVideos[0].play();
    
    setInterval(() => {
      bgVideos[currentVideo].pause();
      bgVideos[currentVideo].classList.remove('active');
      let nextVideo;
      do {
        nextVideo = Math.floor(Math.random() * bgVideos.length);
      } while (nextVideo === currentVideo && bgVideos.length > 1);
      currentVideo = nextVideo;
      bgVideos[currentVideo].classList.add('active');
      bgVideos[currentVideo].play();
    }, 5000);
  }
</script>
