      flex: 0 0 calc(50% - 0.5rem);
      max-width: calc(50% - 0.5rem);
    }

    .games-content {
      flex: 0 0 calc(50% - 0.5rem);
      max-width: calc(50% - 0.5rem);
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
